# =====================================================================
#  Seller Center (admin.recordshoes.com)
#
#  Salin jadi .env, lalu isi bagian yang bertanda ISI_INI.
#  Berkas ini TIDAK berisi rahasia dan aman ikut terunggah.
#  Berkas .env yang sudah jadi TIDAK BOLEH ikut ke git.
# =====================================================================

APP_NAME="RECORD Seller Center"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://admin.recordshoes.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Basis data -------------------------------------------------------
# Dipakai bersama dengan toko. Nama, pengguna, dan sandinya sama persis
# dengan yang dipakai frontend — keduanya membaca satu basis data.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ISI_INI_nama_database
DB_USERNAME=ISI_INI_pengguna_database
DB_PASSWORD=ISI_INI_sandi_database

# --- Sesi -------------------------------------------------------------
# Nama cookie sengaja dibedakan dari toko. Keduanya berbagi satu induk
# domain (recordshoes.com), jadi kalau namanya sama, sesi keduanya saling
# menimpa dan setiap kiriman borang berakhir 419.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=admin.recordshoes.com
SESSION_SECURE_COOKIE=true
SESSION_COOKIE=record-admin-session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# --- Email ------------------------------------------------------------
# "log" berarti email TIDAK benar-benar terkirim, hanya dicatat ke berkas.
# Ganti ke smtp bila sudah punya layanan pengirim.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@recordshoes.com"
MAIL_FROM_NAME="RECORD Seller Center"

# --- Alamat toko (frontend) -------------------------------------------
FRONTEND_URL=https://recordshoes.com

# --- Midtrans ---------------------------------------------------------
# Selama masih sandbox, kuncinya berawalan SB-Mid-.
# Setelah akun produksi disetujui, ganti kuncinya DAN setel true di bawah.
MIDTRANS_SERVER_KEY=ISI_INI_kunci_server_midtrans
MIDTRANS_CLIENT_KEY=ISI_INI_kunci_client_midtrans
MIDTRANS_IS_PRODUCTION=false

# --- Biteship ---------------------------------------------------------
BITESHIP_API_KEY=ISI_INI_kunci_biteship
BITESHIP_API_URL=https://api.biteship.com/v1

# Peringatan muncul di halaman admin saat perkiraan saldo turun di bawah ini.
BITESHIP_AMBANG_SALDO=10000

# --- Asuransi pengiriman ----------------------------------------------
# otomatis = diasuransikan hanya bila ganti rugi tanpa asuransi tidak cukup
ASURANSI_MODE=otomatis
ASURANSI_NILAI_MINIMUM=50000

# --- Identitas & alamat toko (asal pengiriman) ------------------------
STORE_LABEL="RECORD Official Store"
STORE_PHONE=081323065554
STORE_ADDRESS="Jl. Toko Record No.1, Surabaya, Jawa Timur"
STORE_CITY=Surabaya
STORE_POSTAL_CODE=60117
STORE_LATITUDE=-7.2575
STORE_LONGITUDE=112.7521
